# OAAP gateway — single entry point, default deny (RFC-0002).

# On-demand TLS approval (gateway spec, edge section): certificates for
# edge-routed foreign names are obtained per requested hostname at
# handshake time; the portal approves only names under a configured
# edge route. Harmless when no edge routes exist (never consulted).
{
	on_demand_tls {
		ask http://portal:8000/edge/tls-ask
	}
}
#
# Public routes (the only ones, per spec):
#   /auth/*      — login/logout, served by identity
#   /setup*      — first-run wizard, protected by the one-time setup token
#   /platform/*  — static platform assets (RFC-0035): today just the
#                  shared theme stylesheet, no session needed to read it
# Everything else requires an authenticated session, verified by the
# identity service via forward_auth; the verified user and roles are
# passed to apps as trusted headers.

# Anti-spoofing guarantee (deployment contract): identity headers from
# clients are never forwarded. On protected routes forward_auth
# overwrites them from the auth response; on public routes we strip
# them explicitly here.
:80 {
	handle /auth/* {
		request_header -X-OAAP-User
		request_header -X-OAAP-Roles
		reverse_proxy identity:8000
	}

	handle /setup* {
		request_header -X-OAAP-User
		request_header -X-OAAP-Roles
		reverse_proxy portal:8000
	}

	# RFC-0035 (App Design Contract): shared platform assets, static,
	# served by the gateway itself -- no app-facing service needed for
	# a stylesheet. 0.1 is one file (theme.css); a per-tenant theme
	# (D3, a later phase) changes what is served here, never this route.
	handle /platform/* {
		request_header -X-OAAP-User
		request_header -X-OAAP-Roles
		uri strip_prefix /platform
		root * /etc/caddy/static
		file_server
	}

	# Deploy hook (oaap.apps.runtime 2.5): authorized by a per-instance
	# bearer token, validated by the portal — no session, no identity
	# headers. Strip client-sent identity headers like on other public
	# routes.
	handle /deploy/* {
		request_header -X-OAAP-User
		request_header -X-OAAP-Roles
		reverse_proxy portal:8000
	}

	# Fleet status (RFC-0021): read-only status document, authorized by
	# a revocable fleet key, validated by the portal — no session, no
	# identity headers.
	handle /fleet/* {
		request_header -X-OAAP-User
		request_header -X-OAAP-Roles
		reverse_proxy portal:8000
	}

	# The digital twin (oaap.data.twin 0.1, RFC-0031 Schritt 3): the one
	# route every app instance reaches through, never each other's site.
	# Verified the same way every other protected route is -- the caller
	# presents its own machine-principal key (RFC-0027, minted at install
	# for an app that contributes/consumes); 'twin' itself refuses
	# anything whose X-OAAP-User is not 'instance:<name>'.
	#
	# ?instance=oaap.twin (RFC-0027 D5) on purpose, and it MUST stay in
	# sync with appctl.py's TWIN_KEY_SCOPE: an app's own site always
	# names itself here, so a key WITHOUT this parameter would have been
	# refused nowhere but by role and tenant -- it would authenticate
	# against every OTHER app's own route asking only role 'user' in the
	# same tenant, not only this one. Found live on oaap-test 2026-09-10
	# (CURRENT_STATE 125), by testing the very thing the comment here
	# used to claim was safe. 'oaap.twin' can never collide with a real
	# app name (app.id is '[a-z0-9][a-z0-9-]{1,38}[a-z0-9]', never a dot).
	handle /twin/* {
		forward_auth identity:8000 {
			uri /verify?roles=user&instance=oaap.twin
			copy_headers X-OAAP-User X-OAAP-Roles
			header_up -Connection
			header_up -Upgrade
		}
		reverse_proxy twin:8000
	}

	# The MQTT broker's WebSocket listener (oaap.events.broker 0.1,
	# RFC-0032 D2) -- browsers only, reached through the gateway, never
	# published directly (docker-compose.yml). Gates establishing the
	# tunnel to a logged-in session; the MQTT CONNECT inside it still
	# needs its own RFC-0027 key, checked by the broker itself
	# (mosquitto-go-auth against identity) -- two gates for this
	# transport, same posture as the raw device port having none at the
	# gateway layer and one at the MQTT layer (RFC-0015).
	handle /broker/* {
		forward_auth identity:8000 {
			uri /verify?roles=user
			copy_headers X-OAAP-User X-OAAP-Roles
			header_up -Connection
			header_up -Upgrade
		}
		reverse_proxy broker:9001
	}

	handle {
		forward_auth identity:8000 {
			uri /verify
			copy_headers X-OAAP-User X-OAAP-Roles
			# The auth call is a plain GET — never hand it the
			# handshake's hop-by-hop headers. The WSGI server answers
			# those with 400, and forward_auth returns that to the
			# client, killing every WebSocket upgrade before the app
			# is reached (contract guarantee 7).
			header_up -Connection
			header_up -Upgrade
		}
		reverse_proxy portal:8000
	}
}

# App instances get their own gateway listeners (RFC-0005 level 1),
# generated by appctl.py into this directory.
import /etc/caddy/apps/*.caddy
