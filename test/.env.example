# Connection to the OAAP test VM. Copy to .env (gitignored) and adjust.
# Hyper-V assigns a new IP on every reboot — update VM_HOST accordingly.
VM_HOST=172.27.179.200
VM_USER=oaap-admin
VM_SSH_KEY=~/.ssh/oaap_test_vm

# External node oaapx01 (Debian 13) — Claude access (user with NOPASSWD sudo, key-only login); see docs/external-nodes.md
OAAPX01_HOST=oaap.example.org
OAAPX01_IP=203.0.113.10
OAAPX01_USER=oaap-admin
OAAPX01_SSH_KEY=~/.ssh/oaap_strato
