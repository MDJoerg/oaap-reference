#!/usr/bin/env bash
# OAAP node CLI (oaap.core.host §2.3) — local health for technicians
# and service partners, plus node-local uninstall. End users see health
# in the portal.

set -euo pipefail

OAAP_DATA_DIR="${OAAP_DATA_DIR:-/var/lib/oaap}"
APP_DIR="$OAAP_DATA_DIR/app"
MARKER="$OAAP_DATA_DIR/.oaap-installed"

fail() { echo "ERROR: $*" >&2; exit 1; }

compose() { docker compose --project-directory "$APP_DIR" --project-name oaap "$@"; }

version() { cat "$APP_DIR/VERSION" 2>/dev/null || echo "unknown (is OAAP installed?)"; }

status() {
  if [ ! -e "$MARKER" ]; then
    echo "OAAP is not installed on this node ($OAAP_DATA_DIR)."
    exit 1
  fi
  echo "OAAP node status"
  echo "  Version:   $(version)"
  echo "  Data dir:  $OAAP_DATA_DIR"
  echo ""
  echo "Core services:"
  compose ps --format '  {{.Service}}: {{.State}}' 2>/dev/null \
    || { echo "  ERROR: cannot query container runtime (run with sudo, or add your user to the 'docker' group)."; exit 1; }
  total="$(compose ps --services | wc -l)"
  running="$(compose ps --services --filter status=running | wc -l)"
  echo ""
  echo "Apps:"
  apps="$(docker ps -a --filter 'name=^oaap-app-' --format '  {{.Names}}: {{.Status}}' | sed 's/  oaap-app-/  /')"
  if [ -n "$apps" ]; then printf '%s\n' "$apps"; else echo "  (none installed)"; fi
  apps_total="$(docker ps -aq --filter 'name=^oaap-app-' | wc -l)"
  apps_running="$(docker ps -q --filter 'name=^oaap-app-' | wc -l)"
  echo ""
  df -Ph "$OAAP_DATA_DIR" | awk 'NR==2 {printf "Disk: %s free of %s (%s used)\n", $4, $2, $5}'
  echo ""
  if [ "$running" -eq "$total" ] && [ "$total" -gt 0 ] && [ "$apps_running" -eq "$apps_total" ]; then
    echo "Overall: HEALTHY ($running/$total core services, $apps_running/$apps_total apps running)"
  else
    echo "Overall: DEGRADED ($running/$total core services, $apps_running/$apps_total apps running)"
    exit 1
  fi
}

setup_token() {
  [ "$(id -u)" -eq 0 ] || fail "Requires root (sudo oaap setup-token)."
  [ -e "$MARKER" ] || fail "OAAP is not installed on this node ($OAAP_DATA_DIR)."
  if grep -q '"setup_done": true' "$OAAP_DATA_DIR/data/identity/state.json" 2>/dev/null; then
    fail "Setup is already completed — the setup token is no longer valid. Sign in at the portal instead."
  fi
  token="$(grep '^SETUP_TOKEN=' "$APP_DIR/.env" | cut -d= -f2-)"
  port="$(grep '^OAAP_HTTP_PORT=' "$APP_DIR/.env" | cut -d= -f2-)"
  [ -n "$token" ] || fail "No setup token found in $APP_DIR/.env."
  host="${OAAP_HOST:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
  [ -n "$host" ] || host="localhost"
  suffix=""
  [ "$port" != "80" ] && suffix=":$port"
  echo "Finish setup in your browser (creates the first admin user):"
  echo ""
  echo "  URL:          http://$host$suffix/setup"
  echo "  Setup token:  $token"
  echo ""
  echo "The token is valid once, until the first admin exists."
}

uninstall() {
  purge=0 yes=0
  for arg in "$@"; do
    case "$arg" in
      --purge) purge=1 ;;
      --yes)   yes=1 ;;
      *) fail "Unknown option '$arg'. Usage: oaap uninstall [--purge] [--yes]" ;;
    esac
  done

  [ "$(id -u)" -eq 0 ] || fail "Uninstall requires root (sudo oaap uninstall)."
  [ -e "$MARKER" ] || fail "OAAP is not installed on this node ($OAAP_DATA_DIR)."

  echo "This removes the OAAP platform from this node."
  if [ "$purge" -eq 1 ]; then
    echo "  --purge: ALL platform data in $OAAP_DATA_DIR will be DELETED."
  else
    echo "  Platform data in $OAAP_DATA_DIR/data is kept (use --purge to delete it)."
  fi
  if [ "$yes" -ne 1 ]; then
    read -r -p "Continue? [y/N] " answer
    case "$answer" in y|Y|yes|YES) ;; *) echo "Aborted, nothing changed."; exit 1 ;; esac
  fi

  echo "Stopping and removing app instances ..."
  docker ps -aq --filter "name=^oaap-app-" | xargs -r docker rm -f >/dev/null 2>&1 || true
  echo "Stopping and removing core services ..."
  compose down --rmi local --volumes --remove-orphans 2>/dev/null \
    || echo "WARNING: could not remove containers (runtime down?) — continuing."

  systemctl disable --now oaap-deployd.path >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/oaap-deployd.service /etc/systemd/system/oaap-deployd.path
  systemctl daemon-reload >/dev/null 2>&1 || true

  rm -rf "$APP_DIR"
  rm -f "$MARKER"
  if [ "$purge" -eq 1 ]; then
    rm -rf "$OAAP_DATA_DIR"
    echo "Platform and all data removed."
  else
    echo "Platform removed. Data kept at $OAAP_DATA_DIR/data."
  fi
  echo "Run the installer again for a fresh bootstrap."
  rm -f /usr/local/bin/oaap
}

cmd="${1:-status}"
[ "$#" -gt 0 ] && shift
case "$cmd" in
  status)      status ;;
  version)     version ;;
  setup-token) setup_token ;;
  app)         exec python3 "$APP_DIR/appctl.py" "$@" ;;
  store)       exec python3 "$APP_DIR/appctl.py" store "$@" ;;
  external)    exec python3 "$APP_DIR/appctl.py" external "$@" ;;
  backup)      exec python3 "$APP_DIR/appctl.py" backup "$@" ;;
  uninstall)   uninstall "$@" ;;
  update)      exec bash "$APP_DIR/update.sh" "$@" ;;
  *) echo "Usage: oaap [status|version|setup-token|update [--check]|app install|list|remove ...|store list|add-source|remove-source ...|backup create [--to PATH]|uninstall [--purge] [--yes]]" >&2; exit 2 ;;
esac
